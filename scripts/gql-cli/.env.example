# Copy to `.env` (gitignored) and fill in.

# X-Peek-Auth bearer token. This expires — when it does, paste a fresh one here.
# Leave it blank to be prompted (hidden input) at call time instead.
PEEK_AUTH_TOKEN=

# pk-api-key header (v1 mode). Required unless PEEK_API_URL is set.
PEEK_GATEWAY_KEY=

# App id — the URL path segment in v1 mode: <baseUrl>/<appId>/sales
PEEK_APP_ID=

# Optional. Defaults to https://apps.peekapis.com/backoffice-gql
# PEEK_BASE_URL=https://apps.peekapis.com/backoffice-gql

# Optional. A full install app-endpoint URL. If set, it is the SOLE request URL
# and PEEK_APP_ID / PEEK_GATEWAY_KEY are ignored (auth is on the token alone).
# PEEK_API_URL=

# Optional. Set to 1/true to enable PII-gated calls (payments, add-ons, PII reads).
# PEEK_FULL_CUSTOMER_ACCESS=

# Optional. Set to 1 to print request diagnostics to stderr.
# PEEK_DEBUG=
